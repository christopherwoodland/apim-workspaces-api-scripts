<policies>
  <inbound>
    <base />
        <set-backend-service base-url="https://bhs-development-public-foundry-r.cognitiveservices.azure.com/openai" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="msi-access-token" ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
    </set-header>
        <set-header name="api-key" exists-action="delete" />

        <azure-openai-token-limit counter-key="@((context.Subscription != null && !string.IsNullOrEmpty(context.Subscription.Key)) ? context.Subscription.Key : context.Request.IpAddress)" tokens-per-minute="120" estimate-prompt-tokens="true" />

        <rate-limit-by-key calls="1" renewal-period="60" counter-key="@((context.Subscription != null && !string.IsNullOrEmpty(context.Subscription.Key)) ? context.Subscription.Key : context.Request.IpAddress)" />

        <rewrite-uri template="/openai/deployments/gpt-4.1/chat/completions?api-version=2024-02-01" copy-unmatched-params="false" />

    <!-- Optional policy placeholders for a live demo sequence -->
    <!--
    <azure-openai-semantic-cache-lookup score-threshold="0.8" />
    <llm-content-safety shield-prompt="true" />
    -->
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <!-- <azure-openai-semantic-cache-store duration="300" /> -->
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
